# Copy to .env and fill in your values.

# Port the dashboard listens on. On Railway, leave this unset — Railway
# provides PORT automatically and the server reads it.
PORT=3000

# Admin password to log in to the dashboard. REQUIRED in production.
# If unset, it falls back to "admin" (with a warning) — always change it.
ADMIN_PASSWORD=change-me-please

# The following are only SEED values used the first time the config file is
# created. After that, manage them from the dashboard UI (they persist to
# CONFIG_PATH). You normally don't need to set these.
#
# API_KEY=            # initial send API key (otherwise auto-generated)
# WEBHOOK_URL=        # initial webhook url  (otherwise empty)

# Where the WhatsApp session (auth) files are stored.
# Keep this on a PERSISTENT disk so you don't re-scan the QR every restart.
# SESSION_PATH=./dashboard/.wwebjs_auth

# Where the dashboard config (api key, webhook url, webhook secret) is stored.
# Defaults to a "dashboard-config.json" next to the session directory.
# CONFIG_PATH=/data/dashboard-config.json

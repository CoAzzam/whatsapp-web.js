# Copy to .env and fill in your values.

# Port the dashboard listens on.
PORT=3000

# Secret key required for sending messages and controlling the session.
# CHANGE THIS to a long random string.
API_KEY=change-me-please

# Optional: every incoming WhatsApp message is POSTed to this URL as JSON.
# Your external system can read it and reply back via POST /api/send.
# WEBHOOK_URL=https://your-system.example.com/whatsapp-webhook

# Optional: where the WhatsApp session (auth) files are stored.
# Keep this on a PERSISTENT disk so you don't re-scan the QR every restart.
# SESSION_PATH=./dashboard/.wwebjs_auth
